   "Payload": {
    "QuestionID": "QID9",
    "DataExportTag": "imm_att",
    "QuestionText": "<p>How much do you agree or disagree with the following statements?</p>",
    "QuestionType": "Matrix",
    "Selector": "Likert",
    "SubSelector": "SingleAnswer",
    "Choices": {
     "1": {
      "Display": "Immigrants strengthen the U.S. economy."
     },
     "2": {
      "Display": "Immigration levels should be reduced."
     },
     "3": {
      "Display": "Undocumented immigrants should have a path to citizenship."
     }
    },
    "ChoiceOrder": [
     1,
     2,
     3
    ],
    "Answers": {
     "1": {
      "Display": "Strongly disagree"
     },
     "2": {
      "Display": "Disagree"
     },
     "3": {
      "Display": "Somewhat disagree"
     },
     "4": {
      "Display": "Neither agree nor disagree"
     },
     "5": {
      "Display": "Somewhat agree"
     },
     "6": {
      "Display": "Agree"
     },
     "7": {
      "Display": "Strongly agree"
     }
    },
    "AnswerOrder": [
     1,
